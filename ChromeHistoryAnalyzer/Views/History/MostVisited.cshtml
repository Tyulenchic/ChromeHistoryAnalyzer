@model IEnumerable<ChromeHistoryAnalyzer.Models.ChromeUrl>

@{
    ViewData["Title"] = "Часто посещаемые сайты";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">
                <i class="bi bi-star"></i> Часто посещаемые сайты
            </h1>
            <p class="text-muted">Топ-50 самых посещаемых страниц</p>
        </div>
    </div>

    <!-- Быстрая навигация -->
    <div class="row mb-4">
        <div class="col">
            <div class="btn-group" role="group">
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-list-ul"></i> Все записи
                </a>
                <a asp-action="TopSearches" class="btn btn-outline-primary">
                    <i class="bi bi-search"></i> Поисковые запросы
                </a>
                <a asp-action="MostVisited" class="btn btn-outline-primary active">
                    <i class="bi bi-star"></i> Часто посещаемые
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="list-group list-group-flush">
            @{
                var rank = 1;
                var maxVisits = Model.Any() ? Model.Max(u => u.VisitCount) : 1;
            }
            @foreach (var url in Model)
            {
                var percentage = (double)url.VisitCount / maxVisits * 100;
                
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">
                            <span class="badge bg-warning text-dark me-2">#@rank</span>
                            @(string.IsNullOrEmpty(url.Title) ? "Без заголовка" : url.Title)
                        </h5>
                        <span class="badge bg-primary fs-6">@url.VisitCount посещений</span>
                    </div>
                    
                    <div class="progress mb-2" style="height: 25px;">
                        <div class="progress-bar" 
                             role="progressbar" 
                             style="width: @percentage%" 
                             aria-valuenow="@url.VisitCount" 
                             aria-valuemin="0" 
                             aria-valuemax="@maxVisits">
                            @percentage.ToString("F1")%
                        </div>
                    </div>
                    
                    <p class="mb-1 small">
                        <a href="@url.Url" target="_blank" class="text-decoration-none">
                            @url.Url <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </p>
                    
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            @if (url.LastVisitDateTime.HasValue)
                            {
                                <i class="bi bi-clock"></i> 
                                <text>Последний визит: @url.LastVisitDateTime.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</text>
                            }
                        </small>
                        @if (url.TypedCount > 0)
                        {
                            <small class="text-muted">
                                <i class="bi bi-keyboard"></i> Вводилось вручную: @url.TypedCount раз
                            </small>
                        }
                    </div>
                </div>
                rank++;
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">
            <i class="bi bi-info-circle"></i> Данные не найдены
        </div>
    }
</div>