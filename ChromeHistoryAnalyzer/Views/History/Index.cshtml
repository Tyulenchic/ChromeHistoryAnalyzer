@model IEnumerable<ChromeHistoryAnalyzer.Models.ChromeUrl>

@{
    ViewData["Title"] = "История Chrome";
    var searchString = ViewBag.SearchString as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalItems = (int)ViewBag.TotalItems;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">
                <i class="bi bi-clock-history"></i> История просмотров Chrome
            </h1>
            <p class="text-muted">Всего записей: @totalItems.ToString("N0")</p>
        </div>
    </div>

    <!-- Быстрая навигация -->
    <div class="row mb-4">
        <div class="col">
            <div class="btn-group" role="group">
                <a asp-action="Index" class="btn btn-outline-primary active">
                    <i class="bi bi-list-ul"></i> Все записи
                </a>
                <a asp-action="TopSearches" class="btn btn-outline-primary">
                    <i class="bi bi-search"></i> Поисковые запросы
                </a>
                <a asp-action="MostVisited" class="btn btn-outline-primary">
                    <i class="bi bi-star"></i> Часто посещаемые
                </a>
            </div>
        </div>
    </div>

    <!-- Поиск -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="input-group">
                <input type="text" 
                       name="searchString" 
                       value="@searchString" 
                       class="form-control" 
                       placeholder="Поиск по заголовку или URL...">
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i> Искать
                </button>
                @if (!string.IsNullOrEmpty(searchString))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Очистить
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Таблица истории -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50%">Заголовок</th>
                            <th style="width: 25%">URL</th>
                            <th style="width: 10%" class="text-center">Посещений</th>
                            <th style="width: 15%">Последний визит</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var url in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (url.TypedCount > 0)
                                        {
                                            <i class="bi bi-keyboard text-primary me-2" title="Введен вручную"></i>
                                        }
                                        <div>
                                            <div class="fw-medium">
                                                @(string.IsNullOrEmpty(url.Title) ? "(без заголовка)" : url.Title)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="@url.Url" 
                                       target="_blank" 
                                       class="text-decoration-none small"
                                       title="@url.Url">
                                        @(url.Url?.Length > 60 ? url.Url.Substring(0, 60) + "..." : url.Url)
                                        <i class="bi bi-box-arrow-up-right ms-1"></i>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary">@url.VisitCount</span>
                                </td>
                                <td class="small text-muted">
                                    @if (url.LastVisitDateTime.HasValue)
                                    {
                                        @url.LastVisitDateTime.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Пагинация -->
    @if (totalPages > 1)
    {
        <nav aria-label="Навигация по страницам" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" 
                       asp-action="Index" 
                       asp-route-page="@(currentPage - 1)" 
                       asp-route-searchString="@searchString">
                        <i class="bi bi-chevron-left"></i> Назад
                    </a>
                </li>

                @{
                    var startPage = Math.Max(1, currentPage - 2);
                    var endPage = Math.Min(totalPages, currentPage + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchString="@searchString">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" 
                           asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-searchString="@searchString">
                            @i
                        </a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" 
                           asp-action="Index" 
                           asp-route-page="@totalPages" 
                           asp-route-searchString="@searchString">
                            @totalPages
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" 
                       asp-action="Index" 
                       asp-route-page="@(currentPage + 1)" 
                       asp-route-searchString="@searchString">
                        Вперед <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<style>
    .table td {
        vertical-align: middle;
    }
    
    .table tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }
</style>